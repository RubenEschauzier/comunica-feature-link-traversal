{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@comunica/runner/^5.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@comunica/actor-derived-resource-discover-walk-up/^0.0.0/components/context.jsonld"
  ],
  "@id": "urn:comunica:default:Runner",
  "@type": "Runner",
  "actors": [
    {
      "comment": "Not part of actors.json, as it costs a request for every container below the server root that a query reaches. For setups whose pods name their query services in the descriptions of their storage roots only, such as FedShop's discovery benchmark.",
