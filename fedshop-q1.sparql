PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fs: <http://fedshop.example.org/vocab#>

# FedShop q01: products of a type with a numeric property above a threshold, among those offered somewhere.
# kind: analytical
# rows: 20-300
# discovered: 2
SELECT DISTINCT ?product ?label WHERE {
    ?product rdfs:label ?label .

    ?product rdf:type <http://fedshop-proxy:3000/taxonomy/ProductType564#it> .
    ?listing fs:listingOf ?product .
    ?offer bsbm:product ?listing .

    ?product bsbm:productPropertyNumeric1 ?value1 .
    FILTER (?value1 > 1313)

}
