{
  "name": "@comunica/actor-rdf-join-symmetric",
  "version": "0.8.0",
  "description": "Symmetric rdf-join actors (inner cartesian, optional hash) that stream both sides without waiting for either to end",
  "lsd:module": true,
  "license": "MIT",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/comunica-association"
  },
  "homepage": "https://comunica.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/comunica/comunica-feature-link-traversal.git",
    "directory": "packages/actor-rdf-join-symmetric"
  },
  "bugs": {
    "url": "https://github.com/comunica/comunica-feature-link-traversal/issues"
  },
  "keywords": [
    "comunica",
    "actor",
    "rdf-join",
    "symmetric"
  ],
  "sideEffects": false,
  "main": "lib/index.js",
  "typings": "lib/index",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map"
  ],
  "scripts": {
    "build": "yarn run build:ts && yarn run build:components",
    "build:ts": "node \"../../node_modules/typescript/bin/tsc\"",
    "build:components": "componentsjs-generator"
  },
  "dependencies": {
    "@comunica/bus-rdf-join": "^5.0.3",
    "@comunica/core": "^5.0.3",
    "@comunica/mediatortype-join-coefficients": "^5.0.3",
    "@comunica/types": "^5.0.0",
    "@rdfjs/types": "*",
    "asynciterator": "^3.10.0",
    "rdf-string": "^2.0.1"
  }
}
